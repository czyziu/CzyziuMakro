# ── Minimal ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/czyziumakro
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d


# ── HTTPS w LAN (opcjonalne) ─────────────────────────────────────────────────
HTTPS=1
INTERNAL_BASE_URL=https://127.0.0.1:4000
FRONTEND_URL=https://192.168.0.129:4000
ORIGIN=https://192.168.0.129:4000
HTTPS_KEY_PATH=certs/lan-key.pem
HTTPS_CERT_PATH=certs/lan-cert.pem
NODE_TLS_REJECT_UNAUTHORIZED=0


# ── AI / Ollama (opcjonalne) ─────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_TIMEOUT_MS=120000
AI_DEBUG=1


# ── Mail / SMTP (opcjonalne) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_OR_TOKEN
MAIL_FROM="CzyziuMakro <your_email@gmail.com>"
MAIL_TO=your_email@gmail.com